# Create a free API key at https://openrouter.ai/keys and paste it here.
OPENROUTER_API_KEY=

# A free OpenRouter chat model. Override this if it is unavailable.
OPENROUTER_MODEL=nvidia/nemotron-3-super-120b-a12b:free

# The agent connects to the local mock bank API.
BANK_API_URL=http://127.0.0.1:8000

# Demo product terms; disclose this assumed rate to the customer.
BANK_ANNUAL_INTEREST_RATE=12
BANK_DB_PATH=bank_demo.sqlite3
